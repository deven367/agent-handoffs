+  def test_loop_body_reached_through_after(self):
+    # linearize only keeps uops reachable from the SINK. a consumer that references the raw STORE through an AFTER
+    # leaves the loop's END out of the linear list, so _render must still close the loop it opened for the RANGE
+    buf = UOp.param(0, dtypes.int, 4)
+    rng = UOp.range(UOp.param(1, dtypes.int, 1).index(UOp.const(0, dtypes.int)).load(), 0)
+    store = buf.index(rng).store(UOp.const(7).cast(dtypes.int))
+    sink = UOp(Ops.SINK, src=(buf.after(store).index(UOp.const(0, dtypes.int)).load(),), arg=KernelInfo())
+    lin = list(linearize(sink))
+    self.assertGreater(sum(u.op is Ops.RANGE for u in lin), 0)
+    src = Device[Device.DEFAULT].renderer.render(lin)
+    self.assertEqual(src.count("{"), src.count("}"))
+    self.assertIn("for (", src)
+
